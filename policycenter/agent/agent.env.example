# ProvenPath PC agent settings. Copy to policycenter\agent\agent.env on the VM (never commit agent.env).
# Real environment variables override these values.

# The backend on the same VM, and the two shared secrets (the same values as in C:\ProvenPath\.env)
BACKEND_URL=http://localhost:8080
PC_AGENT_KEY=change-me-too
PROVENPATH_GATE_SECRET=change-me
AGENT_NAME=vm-pcagent

# PolicyCenter
PC_HOME=C:\GW10\PolicyCenter
PC_URL=http://localhost:8180/pc
PC_USER=su
PC_PASSWORD=gw
# Run from PC_HOME with PolicyCenter's own JAVA_HOME (vm\start-all.cmd passes it as PC_JAVA_HOME)
PC_STOP_CMD=gwb.bat stopServer
PC_START_CMD=gwb.bat runServer
# A first install of new pattern files can take ~22 min (full compileGosu); values-only changes ~4 min
PC_READY_TIMEOUT_MIN=45
# Set to true to restart PolicyCenter even when no file changed
PC_ALWAYS_RESTART=false

# Fallback: zips dropped here are installed too (results in the log); previous files are backed up per deployment
INBOX_DIR=C:\provenpath\inbox
BACKUP_DIR=C:\ProvenPath-backup\deployments
LOG_DIR=C:\ProvenPath-backup\logs
