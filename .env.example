# Copy to .env (never commit .env). Read by scripts\run-local.* on laptops, vm\start-all.cmd on the VM, and docker compose.
PROVENPATH_GATE_SECRET=change-me-to-a-long-random-string
# Shared with the PC agent (bearer token for /api/v1/pc-agent/*)
PC_AGENT_KEY=change-me-too
# live = Gemini planner (falls back to the fixture if Gemini fails); fixture = offline recorded demo proposals through the real gate
LLM_MODE=live
GEMINI_API_KEY=
# Optional: override the Gemini model when Google retires one
GEMINI_MODEL=gemini-3.8-flash
# Delay between verify.node events so the rule graph animates in Mission Control (0 = instant)
VERIFY_NODE_DELAY_MS=150
# Ports (change if 8080/5432 are taken on your machine; the VM uses 8080)
BACKEND_PORT=8080
DB_PORT=5432
