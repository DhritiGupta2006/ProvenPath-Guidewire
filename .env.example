# Copy to .env (never commit .env). Used by docker compose on laptops and by vm\start-all.cmd on the VM.
PROVENPATH_GATE_SECRET=change-me-to-a-long-random-string
PC_AGENT_KEY=change-me-too
# fixture = offline recorded demo proposals through the real gate; live = Gemini planner (Track C)
LLM_MODE=fixture
GEMINI_API_KEY=
# Delay between verify.node events so the rule graph animates in Mission Control (0 = instant)
VERIFY_NODE_DELAY_MS=150
# Host ports (change if 8080/5432 are taken on your machine)
BACKEND_PORT=8080
DB_PORT=5432
